# Environment variables template
# Do not place real secrets in this file!
# Copy this file to .env for local development

# Database connection string (Local SQLite database)
DATABASE_URL="file:./prisma/dev.db"

# Authentication
# The AUTH_SECRET is generated automatically during the application onboarding process.
# If you need to set it manually for development:
# AUTH_SECRET="your-development-secret-here"
